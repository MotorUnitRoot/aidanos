FROM node:20-slim
WORKDIR /app
COPY package.json ./
COPY server.mjs app.js index.html day.css styles.css start.sh ./
COPY manifest.webmanifest sw.js ./
COPY vault ./vault
# PWA icons: write known PNGs at build time so Cloud Run never fails on missing repo blobs
RUN node -e "const fs=require('fs'); const w=(f,b)=>fs.writeFileSync(f,Buffer.from(b,'base64')); w('icon-180.png',''); w('icon-192.png',''); w('apple-touch-icon.png','');"
EXPOSE 8080
ENV PORT=8080
ENV AIDANOS_HOST=0.0.0.0
CMD ["node", "server.mjs"]
