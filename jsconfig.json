{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "moduleDetection": "force"
  },
  "include": [
    "*.js",
    "*.mjs",
    "design-system/**/*.js",
    "design-system/**/*.mjs"
  ],
  "exclude": ["node_modules", "public/fonts"]
}
